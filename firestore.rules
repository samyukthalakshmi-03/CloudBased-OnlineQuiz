
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // Helper Functions
    // ==========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated()
        && request.auth.uid == userId;
    }

    function userExists(userId) {
      return exists(
        /databases/$(database)/documents/users/$(userId)
      );
    }

    function getUserData() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isFaculty() {
      return isAuthenticated()
        && userExists(request.auth.uid)
        && getUserData().role == 'faculty';
    }

    function isStudent() {
      return isAuthenticated()
        && userExists(request.auth.uid)
        && getUserData().role == 'student';
    }

    // ==========================================
    // 1. Users
    // Document ID = Firebase Authentication UID
    // ==========================================

    match /users/{userId} {

      // Users can read only their own profiles.
      allow read: if isOwner(userId);

      // Public registration can create student profiles only.
      // Faculty profiles must be created by trusted
      // administrative code using Firebase Admin SDK.
      allow create: if isOwner(userId)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'student'
        && request.resource.data.keys().hasAll([
          'email',
          'role'
        ])
        && request.resource.data.keys().hasOnly([
          'name',
          'email',
          'role',
          'createdAt'
        ]);

      // Users cannot change their email or role through
      // Firestore profile updates.
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'name',
            'displayName',
            'photoURL'
          ]);

      // Clients cannot delete profiles directly.
      allow delete: if false;
    }

    // ==========================================
    // 2. Quizzes
    // Public quiz documents must not contain answer keys.
    // ==========================================

    match /quizzes/{quizId} {

      // Signed-in users can read published quizzes.
      // Faculty can also read their own unpublished quizzes.
      allow read: if isAuthenticated()
        && (
          resource.data.isPublished == true
          || (
            isFaculty()
            && resource.data.createdBy == request.auth.uid
          )
        );

      // Only faculty can create quizzes under their own UID.
      allow create: if isFaculty()
        && request.resource.data.createdBy == request.auth.uid;

      // Only the original faculty creator can update a quiz.
      // Ownership cannot be transferred.
      allow update: if isFaculty()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy;

      // Only the original faculty creator can delete a quiz.
      allow delete: if isFaculty()
        && resource.data.createdBy == request.auth.uid;
    }

    // ==========================================
    // 3. Quiz Answers
    // Correct answers must not be exposed to students.
    // ==========================================

    match /quizAnswers/{quizId} {

      // Only the faculty creator can read the answer key.
      allow read: if isFaculty()
        && resource.data.createdBy == request.auth.uid;

      // Only faculty can create answer keys for their quizzes.
      allow create: if isFaculty()
        && request.resource.data.createdBy == request.auth.uid
        && exists(
          /databases/$(database)/documents/quizzes/$(quizId)
        )
        && get(
          /databases/$(database)/documents/quizzes/$(quizId)
        ).data.createdBy == request.auth.uid;

      // Preserve answer-key ownership during updates.
      allow update: if isFaculty()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy
        && exists(
          /databases/$(database)/documents/quizzes/$(quizId)
        )
        && get(
          /databases/$(database)/documents/quizzes/$(quizId)
        ).data.createdBy == request.auth.uid;

      allow delete: if isFaculty()
        && resource.data.createdBy == request.auth.uid;
    }

    // ==========================================
    // 4. Results
    // Results are written by trusted server-side code.
    // ==========================================

    match /results/{resultId} {

      // Students can read their own results.
      // Faculty can read results associated with their quizzes.
      allow read: if isAuthenticated()
        && (
          resource.data.studentId == request.auth.uid
          || (
            isFaculty()
            && resource.data.facultyId == request.auth.uid
          )
        );

      // All client-side result writes are denied.
      allow create, update, delete: if false;
    }

    // ==========================================
    // 5. Leaderboards
    // Store only fields intended for leaderboard display.
    // ==========================================

    match /leaderboards/{leaderboardId} {

      // Signed-in users can read leaderboard entries.
      allow read: if isAuthenticated();

      // Only trusted server-side code can write entries.
      allow write: if false;
    }

    // ==========================================
    // Default Deny
    // Any document not explicitly allowed above is denied.
    // ==========================================

  }
}
