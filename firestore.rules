rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // Helper Functions
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isFaculty() {
      return isAuthenticated() && getUserData().role == 'faculty';
    }

    function isStudent() {
      return isAuthenticated() && getUserData().role == 'student';
    }

    // ==========================================
    // 1. Users Collection
    // Document ID: Firebase Authentication UID
    // ==========================================
    match /users/{userId} {
      // Authenticated users can read profile data (e.g. for display names on leaderboards)
      allow read: if isAuthenticated();

      // Users can only create their own user document with valid initial role
      allow create: if isOwner(userId)
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.role in ['student', 'faculty'];

      // Users CANNOT change their assigned role after initial profile creation
      allow update: if isOwner(userId)
                    && request.resource.data.role == resource.data.role;

      // Profile documents cannot be deleted directly
      allow delete: if false;
    }

    // ==========================================
    // 2. Quizzes Collection (Sanitized representation)
    // Document ID: Auto-generated
    // Questions stored here do NOT contain `correctAnswer`
    // ==========================================
    match /quizzes/{quizId} {
      // Students can read published quizzes; Faculty can read any quiz they created
      allow read: if isAuthenticated() && (
        resource.data.isPublished == true ||
        (isFaculty() && resource.data.createdBy == request.auth.uid)
      );

      // Only verified faculty can create quizzes, bound to their UID
      allow create: if isFaculty() && request.resource.data.createdBy == request.auth.uid;

      // Only the faculty creator can update or delete their quiz
      allow update, delete: if isFaculty() && resource.data.createdBy == request.auth.uid;
    }

    // ==========================================
    // 3. Quiz Answers Collection (Restricted)
    // Document ID: matches quizId
    // Stores authoritative answer keys
    // Inaccessible to students through client-side queries, even after submission
    // ==========================================
    match /quizAnswers/{quizId} {
      // Only the faculty creator can read or manage their answer keys.
      // Students CANNOT read quizAnswers directly via client Firestore queries.
      allow read: if isFaculty() && resource.data.createdBy == request.auth.uid;
      allow create: if isFaculty() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isFaculty() && resource.data.createdBy == request.auth.uid;
    }

    // ==========================================
    // 4. Results Collection
    // Document ID: deterministic `${studentId}_${quizId}`
    // Server-side grading only: All writes are performed via Firebase Admin SDK
    // ==========================================
    match /results/{resultId} {
      // Students can read only their own results;
      // Faculty can read results associated with quizzes they created
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        (isFaculty() && resource.data.facultyId == request.auth.uid)
      );

      // Students cannot directly create result documents.
      // Students cannot modify scores or completed submissions.
      // Only trusted server-side code (Firebase Admin SDK) can create and finalize results.
      allow create, update, delete: if false;
    }

    // ==========================================
    // 5. Leaderboards Collection (Sanitized public entries)
    // Document ID: deterministic `${studentId}_${quizId}`
    // ==========================================
    match /leaderboards/{leaderboardId} {
      // Authenticated users can read sanitized leaderboard rankings
      allow read: if isAuthenticated();

      // Only trusted server-side code (Firebase Admin SDK) can create, update, or delete entries
      allow write: if false;
    }
  }
}
